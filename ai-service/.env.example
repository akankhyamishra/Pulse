# AI Service Environment Variables — copy this file to .env and fill in your keys

# Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant vector database
# Option A - Qdrant Cloud (https://cloud.qdrant.io, free tier available)
QDRANT_URL=https://your-cluster.us-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Option B - Local Qdrant (run: docker run -p 6333:6333 qdrant/qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Port for this service (default 8001)
PORT=8001

# Redis — DJ session history (optional, sessions fallback to in-memory)
REDIS_URL=

# Cloudinary — screenshot image cloud storage (optional)
# Sign up free at https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# YouTube Data API v3 — trending video carousel + trending song enrichment (optional)
# Google Cloud Console → Enable "YouTube Data API v3" → Credentials → API Key
# Same Google project as Gemini. Free quota: 10,000 units/day
YOUTUBE_API_KEY=your_youtube_api_key

# Reddit API — social mention tracking for trending predictor (optional)
# reddit.com/prefs/apps → Create App (type: script) → copy client_id & secret
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Kafka — event streaming for trending predictions (optional)
# Confluent Cloud free tier: confluent.io, or run locally: docker run confluentinc/cp-kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
